FROM --platform=i386 i386/debian:bookworm

ARG DEBIAN_FRONTEND=noninteractive

# 1. 合并更新、安装、清理为一层
# 2. 使用 --no-install-recommends 拒绝安装推荐包
# 3. rm -rf /var/lib/apt/lists/* 才是真正减小体积的清理方式
RUN apt-get update && apt-get -y upgrade && \
    apt-get -y install --no-install-recommends \
    apt-utils gcc g++ cmake make \
    neovim unzip ruby  \
    fakeroot dbus base whiptail hexedit \
    patch ucf file luajit lua5.4 dialog curl \
    less netcat-openbsd \
    # 移除了 cowsay, wamerican, manpages 以节省空间
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m user && echo "user:password" | chpasswd

COPY --chown=user:user ./examples /home/user/examples
RUN chmod -R +x /home/user/examples/lua

WORKDIR /home/user/
ENV HOME="/home/user" TERM="xterm" USER="user" SHELL="/bin/bash" EDITOR="vim" LANG="en_US.UTF-8" LC_ALL="C"

RUN echo 'root:password' | chpasswd

CMD [ "/bin/bash" ]